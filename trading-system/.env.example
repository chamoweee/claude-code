# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real keys.

# Twelve Data API key (free tier works for daily bars on a small universe).
# Get one at https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Interactive Brokers — only needed once execution/broker_ibkr.py is wired up
# and you're running TWS/IB Gateway locally. Leave blank for backtest/paper.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
