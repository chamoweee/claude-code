# Copy to .env and fill in what you have. Every value here is optional --
# the agent degrades gracefully (and logs it) when a key is missing.

# CoinGecko free-tier "demo" API key (higher rate limit). Leave blank to use
# the public API with default rate limits.
COINGECKO_API_KEY=

# If set, output/live_report.html and the dashboard get a short plain-English
# "what matters today" summary generated from the computed tables/insights.
# If unset, that section is skipped entirely -- no summary is fabricated.
ANTHROPIC_API_KEY=

# Exchange used for OHLCV history via ccxt: "kraken" (default) or "binance".
CCXT_EXCHANGE=kraken

# SMTP settings for daily digests and instant high-priority alerts.
# All four of HOST/USER/PASSWORD/TO are required for email to be enabled;
# missing any of them disables email and logs why.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
